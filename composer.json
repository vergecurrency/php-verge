{
    "name": "vergecurrency/verge-rpc",
    "description": "A JSON-RPC client for Verge Currency in PHP.",
    "type": "library",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Verge\\": "src/Verge/"
        }
    },
    "require": {
        "php": ">=8.1",
        "ext-curl": "*",
